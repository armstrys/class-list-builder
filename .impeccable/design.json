  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single committed action in a dialog or toolbar.",
      "html": "<button class=\"ds-btn-primary\">Re-Optimize</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:6px;border:1.5px solid var(--accent);background:var(--accent);color:var(--accent-fg);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:filter .15s;} .ds-btn-primary:hover{filter:brightness(1.08);} .ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default action: neutral, hairline bordered.",
      "html": "<button class=\"ds-btn-secondary\">Save Lists</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:6px;border:1.5px solid var(--border);background:var(--surface);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s,border-color .15s;} .ds-btn-secondary:hover{background:var(--surface2);} .ds-btn-secondary:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Ghost Icon Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Toolbar icon control. Always carries aria-label and title.",
      "html": "<button class=\"ds-btn-ghost\" aria-label=\"Undo\">Undo</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;padding:4px 10px;border-radius:6px;border:1.5px solid transparent;background:transparent;color:var(--text2);font-family:'DM Sans',sans-serif;font-size:12px;cursor:pointer;transition:background .15s,color .15s;} .ds-btn-ghost:hover{background:var(--surface2);color:var(--text);} .ds-btn-ghost:disabled{opacity:.45;cursor:not-allowed;} .ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action, wash fill that inverts on hover.",
      "html": "<button class=\"ds-btn-danger\">Clear All</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:6px;border:1.5px solid transparent;background:var(--danger-light);color:var(--danger);font-family:'DM Sans',sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s,color .15s;} .ds-btn-danger:hover{background:var(--danger);color:#fff;} .ds-btn-danger:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Student Card",
      "kind": "card",
      "refersTo": "card",
      "description": "The dense unit of the board. Focusable, opens details on Enter/Space.",
      "html": "<div class=\"ds-student-card\" role=\"button\" tabindex=\"0\"><span class=\"ds-badge\">F</span><span class=\"ds-sid\">S0142</span><span class=\"ds-name\">Amara Okafor</span><span class=\"ds-lock\">Locked</span></div>",
      "css": ".ds-student-card{display:flex;align-items:center;gap:6px;padding:5px 8px;border-radius:6px;border:1.5px solid var(--border);background:var(--surface);font-family:'DM Sans',sans-serif;font-size:12px;cursor:grab;box-shadow:inset 2px 0 0 var(--accent);} .ds-student-card:hover{border-color:oklch(70% 0.08 168);} .ds-student-card:focus-visible{outline:2px solid var(--accent);outline-offset:2px;} .ds-badge{display:inline-flex;align-items:center;justify-content:center;padding:1px 6px;border-radius:4px;background:var(--purple-light);color:var(--purple);font-size:10.5px;font-weight:600;} .ds-sid{font-family:'DM Mono',monospace;font-size:10px;color:var(--text3);} .ds-name{font-weight:500;flex:1;} .ds-lock{font-size:11px;color:var(--accent);font-weight:600;}"
    },
    {
      "name": "Class Column",
      "kind": "card",
      "refersTo": "card",
      "description": "One class: fixed header, scrolling cards, fixed stat footer.",
      "html": "<div class=\"ds-class-col\"><div class=\"ds-col-head\"><span class=\"ds-num\">1</span><span class=\"ds-col-name\">Ms. Rivera</span><span class=\"ds-count\">24</span></div><div class=\"ds-col-body\"><div class=\"ds-stub\">Drop students here</div></div><div class=\"ds-col-foot\"><span class=\"ds-badge\">M 12</span><span class=\"ds-badge ds-f\">F 12</span></div></div>",
      "css": ".ds-class-col{width:340px;display:flex;flex-direction:column;background:var(--surface);border:1.5px solid var(--border);border-radius:10px;font-family:'DM Sans',sans-serif;} .ds-col-head{display:flex;align-items:center;gap:8px;padding:12px 14px 10px;border-bottom:1px solid var(--border);} .ds-num{width:22px;height:22px;border-radius:50%;background:var(--accent-light);color:var(--accent);font-size:11px;font-weight:600;display:flex;align-items:center;justify-content:center;} .ds-col-name{font-weight:600;font-size:14px;flex:1;} .ds-count{font-size:11px;color:var(--text3);background:var(--surface2);padding:2px 7px;border-radius:10px;} .ds-col-body{padding:6px;min-height:60px;} .ds-stub{text-align:center;padding:20px 0;color:var(--text3);font-size:12px;} .ds-col-foot{padding:10px 14px;border-top:1px solid var(--border);display:flex;gap:4px;} .ds-badge{display:inline-flex;padding:1px 6px;border-radius:4px;font-size:10.5px;font-weight:600;background:var(--blue-light);color:var(--blue);} .ds-f{background:var(--purple-light);color:var(--purple);}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Standard field. Teal border on focus, plus the global focus ring.",
      "html": "<label class=\"ds-field\"><span class=\"ds-label\">Filter students by name</span><input class=\"ds-input\" placeholder=\"Filter by name...\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:5px;} .ds-label{font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;color:var(--text2);} .ds-input{padding:8px 10px;border:1.5px solid var(--border);border-radius:6px;background:var(--surface);color:var(--text);font-family:'DM Sans',sans-serif;font-size:13px;transition:border-color .15s;} .ds-input:focus{border-color:var(--accent);} .ds-input:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Step Pills",
      "kind": "nav",
      "refersTo": "button-ghost",
      "description": "The two-step workflow in the header. Pill radius is reserved for this and counts.",
      "html": "<nav class=\"ds-steps\"><button class=\"ds-step ds-step-done\">1 - Setup</button><button class=\"ds-step ds-step-active\">2 - Optimize</button></nav>",
      "css": ".ds-steps{display:flex;gap:4px;} .ds-step{padding:3px 12px;border-radius:20px;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;border:1.5px solid transparent;background:var(--surface2);color:var(--text3);cursor:pointer;transition:all .15s;} .ds-step-done{color:var(--text2);} .ds-step-active{color:var(--accent);background:var(--accent-light);border-color:var(--accent);} .ds-step:focus-visible{outline:2px solid var(--accent);outline-offset:2px;}"
    },
    {
      "name": "Stat Bar",
      "kind": "custom",
      "refersTo": "card",
      "description": "Per-class criterion distribution. Fill animates via scaleX, not width.",
      "html": "<div class=\"ds-stat\"><span class=\"ds-stat-label\">Math</span><div class=\"ds-track\"><div class=\"ds-fill\" style=\"transform:scaleX(.68)\"></div></div><span class=\"ds-val\">68</span></div>",
      "css": ".ds-stat{display:flex;align-items:center;gap:6px;font-family:'DM Sans',sans-serif;font-size:11px;} .ds-stat-label{color:var(--text3);width:60px;} .ds-track{flex:1;height:5px;background:var(--surface2);border-radius:3px;overflow:hidden;} .ds-fill{height:100%;width:100%;border-radius:3px;background:var(--accent);transform-origin:left;transition:transform .3s;} .ds-val{font-family:'DM Mono',monospace;font-size:10.5px;color:var(--text2);width:30px;text-align:right;}"
    }
