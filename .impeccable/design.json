  "narrative": {
    "northStar": "The Rostering Desk",
    "overview": "This is a work surface, not a product page. The visual world is a well-lit desk at the end of a term: warm paper underneath, a crisp white sheet on top, one confident green ink for the things that matter, and everything else in a measured grey hierarchy so that a hundred student names can be scanned without fatigue. Nothing glows, nothing bounces, nothing celebrates. The interface is quiet because the data is loud.\n\nThe one moment of visual emphasis is reserved for decisions the teacher must defend: the balance score, the constraint verdict, the locked students. That is deliberate scarcity. When teal appears, it means this is the thing a principal will ask you about.\n\nThe chrome is a two-step workflow, Setup then Optimize, stated in the header rather than hidden in navigation. There is no dashboard, no sidebar tree, no settings labyrinth.\n\nThe print report is a deliberate exception: it forces its own light palette and point-based scale because paper has no theme. Treat it as a separate contract, not as drift.",
    "keyCharacteristics": [
      "Warm off-white ground (#F7F6F2), pure-white surfaces, ink-black text.",
      "One saturated accent (teal) used for state and selection, never decoration.",
      "A three-value grey ramp carries all secondary information.",
      "Monospace is reserved exclusively for numbers.",
      "Flat at rest; depth is a hairline border, not a shadow.",
      "Density is the default; the layout tightens for print."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "The accent appears on 10% or less of any screen. Its rarity is what makes satisfied, locked, and selected readable at a glance.",
        "section": "colors"
      },
      {
        "name": "The Semantic Pair Rule",
        "body": "A semantic hue is only ever used as a solid on its own wash, or as text on a neutral surface.",
        "section": "colors"
      },
      {
        "name": "The Numbers Are Mono Rule",
        "body": "Any value a user might compare down a column is DM Mono. Any word is DM Sans. There are no exceptions.",
        "section": "typography"
      },
      {
        "name": "The Tight Ramp Rule",
        "body": "Working UI lives in a 10-16px band, in half-pixel steps. Three sizes sit above it and are each single-purpose: 20px section headings, 28-32px welcome headings, and the 56px balance figure. A fourth large size would flatten that hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "A surface is flat unless it floats. Cards, columns and panels never take a shadow.",
        "section": "elevation"
      },
      {
        "name": "The Locked-Shadow Rule",
        "body": "State markers are inset shadows so the element box does not change size.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the accent scarce; teal marks state, selection, and the one most important number.",
      "Do set every number in DM Mono and every word in DM Sans.",
      "Do use the surface ramp for depth and reserve shadows for floating layers.",
      "Do express state markers as inset shadows.",
      "Do keep ink-faint at or above 4.5:1 against surface-sunk at 10-12px.",
      "Do give every icon-only control an aria-label and a title.",
      "Do announce async status in the live region.",
      "Do preserve the print report's forced light palette."
    ],
    "donts": [
      "Don't add a shadow to a static card, panel, or class column.",
      "Don't add a working-UI type size outside the 10-16px band, or a heading size beyond the three sanctioned ones.",
      "Don't use pill radius for actions; pills are for steps and counts.",
      "Don't render a dialog inside the aria-hidden app root.",
      "Don't animate width, height, top, or left; transform and opacity only.",
      "Don't use a semantic hue as a solid behind white text at small sizes.",
      "Don't add a hex value or an icon library.",
      "Don't define a design token name and reference a different one."
    ]
  }
